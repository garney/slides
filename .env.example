PORT=3090
APP_PUBLIC_URL=http://localhost:3090

# Supabase → Project Settings → Database → Connection string (URI, use "Transaction" pooler for serverless later)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Set to false for local `supabase start` postgres on localhost
DATABASE_SSL=require

# Supabase → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
# Optional: server-only tasks (future Storage admin uploads). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public bucket for slide image uploads (see README). Leave unset to disable uploads.
# SUPABASE_STORAGE_BUCKET=slide-images

# Comma-separated admin emails (edit any public deck). Match Supabase Auth user emails.
ADMIN_EMAILS=you@example.com

# MCP (Streamable HTTP at /mcp)
# MCP_ENABLED=true
# MCP_API_KEY=generate-a-long-random-secret

# PUBLIC_OPEN_EDIT=true

# Legacy S3-compatible storage (MinIO, R2, AWS). Only if not using Supabase Storage.
# S3_ASSETS_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
