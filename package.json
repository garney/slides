{
  "name": "slides",
  "version": "0.1.0",
  "description": "Slide CMS with Reveal.js, Supabase Postgres, and Supabase Auth",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "node --watch-path=./src --watch src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "migrate": "node src/jobs/migrate.js",
    "seed:help": "node src/jobs/seed-help-presentation.js"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.0.11",
    "marked": "^15.0.12",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "pg": "^8.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "reveal.js": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
